{
  "name": "@web/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "bun --cwd apps/admin dev",
    "dev:landing": "bun --cwd apps/landing dev",
    "build": "bun --filter '*' build",
    "type-check": "bun --filter '*' type-check",
    "test:unit": "bun --filter '*' test:unit",
    "format": "bun --filter '*' format"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "overrides": {
    "vue": "rc",
    "@vue/compiler-core": "rc",
    "@vue/compiler-dom": "rc",
    "@vue/compiler-sfc": "rc",
    "@vue/compiler-ssr": "rc",
    "@vue/compiler-vapor": "rc",
    "@vue/reactivity": "rc",
    "@vue/runtime-core": "rc",
    "@vue/runtime-dom": "rc",
    "@vue/runtime-vapor": "rc",
    "@vue/server-renderer": "rc",
    "@vue/shared": "rc",
    "@vue/compat": "rc",
    "typescript": "npm:typescript-native-bridge@latest"
  }
}
