# Native local development settings. Copy this file to .env before starting
# the backend with `just server`. Do not use these placeholder values in a
# shared or production environment.

# One public URL for Flutter and Admin clients.
API_BASE_URL=http://127.0.0.1:8000

# The single native Go application listener.
API_PORT=8000

# Docker Compose host port for the public API.
GATEWAY_PORT=8000

# Native dependencies. Start PostgreSQL, Redis, and RabbitMQ separately.
# Set PostgreSQL credentials before starting the backend.
DATABASE_URL=postgresql://driveapp@127.0.0.1:5432/driveapp?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://127.0.0.1:5672

POSTGRES_USER=driveapp
POSTGRES_PASSWORD=
POSTGRES_DB=driveapp

# Docker Compose publishes PostgreSQL on this host port when Docker is used.
POSTGRES_HOST_PORT=55432

# Set a unique random value of at least 32 characters.
JWT_SECRET=

# Optional: location search and routing need a Mapbox token.
MAPBOX_ACCESS_TOKEN=

# Optional: registration verification emails require a configured SMTP account.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=DriveApp
MAIL_SECURITY=starttls
MAIL_TIMEOUT=10s

# Browser clients that can call the API directly.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Published Docker host ports.
ADMIN_APP_PORT=5173
ADMIN_APP_ORIGIN=http://localhost:5173
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
