# API and gateway
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=info
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# PostgreSQL
DATABASE_URL=postgresql://driveapp@127.0.0.1:55432/driveapp?sslmode=disable
POSTGRES_USER=driveapp
POSTGRES_PASSWORD=
POSTGRES_DB=driveapp
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=55432

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379
REDIS_HOST_PORT=6379

# Authentication
JWT_SECRET=
ADMIN_USER_IDS=

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=driveapp
MINIO_SECRET_KEY=replace-with-a-long-random-secret
MINIO_BUCKET=private-objects
MINIO_USE_SSL=false
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Email
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=DriveApp
MAIL_SUBJECT=DriveApp verification code
MAIL_SECURITY=starttls
MAIL_TIMEOUT=10s

# HTTP security
CORS_ALLOWED_ORIGINS=http://localhost:5173
ENABLE_HSTS=false
TRUSTED_PROXY_CIDRS=

# Rate limits
AUTH_RATE_LIMIT_REQUESTS_PER_MINUTE=10
REFRESH_RATE_LIMIT_REQUESTS_PER_MINUTE=10
LOCATION_RATE_LIMIT_REQUESTS_PER_MINUTE=60
FARE_RATE_LIMIT_REQUESTS_PER_MINUTE=30
CONNECTION_RATE_LIMIT_REQUESTS_PER_MINUTE=30
TELEMETRY_RATE_LIMIT_REQUESTS_PER_MINUTE=600
MUTATION_RATE_LIMIT_REQUESTS_PER_MINUTE=120
READ_RATE_LIMIT_REQUESTS_PER_MINUTE=300

# Request body limits
JSON_BODY_LIMIT_BYTES=16384
UPLOAD_BODY_LIMIT_BYTES=10485760

# PostgreSQL pool
POSTGRES_MAX_OPEN_CONNECTIONS=25
POSTGRES_MIN_CONNECTIONS=0
POSTGRES_MIN_IDLE_CONNECTIONS=0
POSTGRES_CONNECTION_MAX_LIFETIME=30m
POSTGRES_CONNECTION_MAX_IDLE_TIME=5m
POSTGRES_PING_TIMEOUT=5s

# Ride policy
REPORTING_TIMEZONE=Asia/Manila
PASSENGER_NO_SHOW_WAIT=5m
DRIVER_LOCATION_MAX_AGE=45s
RIDE_ARRIVAL_RADIUS_METERS=250
RIDE_COMPLETION_RADIUS_METERS=250
BID_SESSION_DURATION=5m

# Mapbox
MAPBOX_ACCESS_TOKEN=

# Admin web app
ADMIN_APP_PORT=5173
ADMIN_APP_HOST_PORT=5173
ADMIN_APP_ORIGIN=http://localhost:5173
